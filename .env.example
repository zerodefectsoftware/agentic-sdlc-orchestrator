# Copy to .env and edit. .env is gitignored; this file is not.
#
# What belongs here: credentials, paths, and the worker switch — who you are and
# where things live. What does NOT belong here: the model and effort. Those are
# per-node fields in the plan graph (D16), so a run's cost profile stays in the
# artifact that describes the run.

# ─── Credentials ──────────────────────────────────────────────────────────────
# Required only when ORCHESTRATOR_WORKER=live. Stub and replay runs never call
# the API, which is why the test suite needs no credential at all.
ANTHROPIC_API_KEY=

# ─── Worker ───────────────────────────────────────────────────────────────────
# stub    scripted results — tests
# replay  recorded fixtures — deterministic demos, no API calls, no latency
# live    real models and subprocesses
ORCHESTRATOR_WORKER=stub

# ─── Paths ────────────────────────────────────────────────────────────────────
ORCHESTRATOR_RUNS_DIR=runs
ORCHESTRATOR_FIXTURES_DIR=fixtures
ORCHESTRATOR_PLANS_DIR=plans
ORCHESTRATOR_PROMPTS_DIR=prompts

# Defaults to sqlite:///<runs_dir>/orchestrator.db when unset.
# ORCHESTRATOR_DB_URL=sqlite:///runs/orchestrator.db

# ─── Execution ────────────────────────────────────────────────────────────────
# Seconds before a tool node is abandoned. A command that never returned an exit
# code produces no fact, so its gate ERRORs rather than failing.
ORCHESTRATOR_TOOL_TIMEOUT=600

# How many nodes in a wave may execute concurrently.
ORCHESTRATOR_MAX_WORKERS=4
