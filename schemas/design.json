        "kind"
      ],
      "title": "Export",
      "type": "object"
    },
    "Interface": {
      "additionalProperties": false,
      "description": "What one module exports, and what it imports from its siblings.\n\nThis is the contract parallel implementers write against. It is authored by\nthe architect and generated into stubs deterministically, so a module's\ncallers and its author are reading the same names from the same source.",
      "properties": {
        "module": {
          "title": "Module",
          "type": "string"
