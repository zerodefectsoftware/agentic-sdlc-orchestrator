    "Export": {
      "additionalProperties": false,
      "description": "One public name a module promises its siblings (D24).\n\n`raises` is not decoration. Exceptions cross module boundaries more often\nthan functions do, and they are the names an implementer is likeliest to\ninvent \u2014 a live fan-out died on three exception names imported from a module\nwhose author had not run.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
